# microservice specific routes

POST        /employer/:empRef/employment/:nino                    uk.gov.hmrc.individualincomeipstub.controller.EmploymentController.create(empRef: uk.gov.hmrc.domain.EmpRef, nino: uk.gov.hmrc.domain.Nino)
POST        /:utr/self-assessment                                 uk.gov.hmrc.individualincomeipstub.controller.SelfAssessmentController.create(utr: uk.gov.hmrc.domain.SaUtr)
GET         /individuals/nino/:nino/employments/income            uk.gov.hmrc.individualincomeipstub.controller.EmploymentIncomeController.employments(nino: uk.gov.hmrc.domain.Nino, interval: uk.gov.hmrc.individualincomeipstub.util.Interval)
GET         /individuals/nino/:nino/self-assessment/income        uk.gov.hmrc.individualincomeipstub.controller.SelfAssessmentIncomeController.income(nino: uk.gov.hmrc.domain.Nino, startYear: Int, endYear: Int)
